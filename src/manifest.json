{
  "manifest_version": 2,
  "name": "Subtraverse",
  "version": "0.1.0",
  "description": "開始URL配下のリンクだけをたどってURL一覧を作り、選んだものをZIPで一括保存します。",
  "browser_specific_settings": {
    "gecko": {
      "id": "subtraverse@lightspeedc.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "<all_urls>",
    "downloads",
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": [
      "lib/jszip.min.js",
      "lib/util.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Subtraverse を開閉",
    "default_icon": "icons/icon.svg"
  },
  "sidebar_action": {
    "default_title": "Subtraverse",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Subtraverse のサイドバーを開閉"
    }
  }
}
